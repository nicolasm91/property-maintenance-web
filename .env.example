# Auth0 tenant domain (no scheme), e.g. "my-tenant.us.auth0.com".
VITE_AUTH0_DOMAIN="<tenant>.auth0.com"
# Client ID of the "Single Page Application" registered in Auth0.
VITE_AUTH0_CLIENT_ID="<client-id>"
# Identifier of the API registered in Auth0. Must match the API's AUTH0_AUDIENCE.
VITE_AUTH0_AUDIENCE="https://property-maintenance-api"
VITE_API_URL="http://localhost:3000"
